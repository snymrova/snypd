# S13: the editorial lane builds the same corpus into its own dist; bench/page.* joins bench/*.json
corpora/*/dist-*/

# Generated by `bun packaging/npm/build.ts --formula` from a full release build: it names GitHub
# release assets and their sha256s, so a copy checked in here is wrong between releases. The workflow
# attaches the real one to the release it describes (packaging/homebrew/README.md).
packaging/homebrew/snypd.rb

# Decision 53 (S18g): working copies for dogfooding. Every directory in here is its own git repo —
# snypd.rocks is *cloned* into it, not tracked here, because S19a builds it from its own remote and a
# site the host builds from git cannot also be a subdirectory of this one. `bun run scratch` makes one.
sites/
