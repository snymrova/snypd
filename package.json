{
  "name": "snypd-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Snypd — an MCP-native CMS on Bun",
  "license": "MIT",
  "workspaces": ["packages/*", "themes/*"],
  "engines": { "bun": ">=1.3.14" },
  "scripts": {
    "snypd": "bun packages/cli/src/index.ts",
    "test": "bun test",
    "bench": "bun packages/cli/src/index.ts bench",
    "bench:quick": "bun packages/cli/src/index.ts bench --quick",
    "corpus": "bun packages/bench/src/corpus.ts",
    "release": "bun packaging/npm/build.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": { "@types/bun": "latest", "typescript": "^5.6.0" }
}
